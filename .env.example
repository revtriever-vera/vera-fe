VITE_API_URL=http://localhost:3333
# Alvo de build: unified (padrão, tudo), tenant (sem admin) ou admin (só o admin da plataforma, subdomínio próprio).
VITE_APP_TARGET=unified
# Chave publica do PostHog (analytics de produto). Vazia = analytics desligado (no-op em dev e testes).
VITE_POSTHOG_KEY=
# Host de ingestao do PostHog.
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
VITE_TERMS_URL=
VITE_PRIVACY_URL=
VITE_LOGIN_PHOTO_URL=
# Link do arquivo da lista de emissores no GitHub, mostrado quando a busca não acha o emissor. Vazia = sem link.
VITE_REPO_URL=
